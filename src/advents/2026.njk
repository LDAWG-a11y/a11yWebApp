  <h1>Accessibility advent calendar 2026</h1>
  <section class="a11y__controls" aria-labelledby="acc1">
    <h2 class="accordion__heading" data-no-accent>
      <button class="accordion__btn" aria-expanded="false" aria-controls="accPanel1" id="acc1" accesskey="6">Accessibility options<span class="accordion__badge"></span></button>
